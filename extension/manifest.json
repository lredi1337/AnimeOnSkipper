{
  "manifest_version": 3,
  "name": "AnimeOn Skipper — Пропуск Опенингов и Эндингов",
  "version": "2.4.0",
  "description": "Автоматический и ручной пропуск опенингов и эндингов на AnimeOn через нативные метки плеера и базу Cloudflare.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.animeon.cc/*",
    "*://*.animeon.co/*",
    "*://*.animeon.su/*",
    "*://*.animeon.org/*",
    "*://*.animeon.to/*",
    "*://*.animeon.tv/*",
    "*://*.animeon.site/*",
    "*://*.kodikplayer.com/*",
    "*://*.kodik.info/*",
    "*://*.kodik.cc/*",
    "*://*.kodik.biz/*",
    "*://*.workers.dev/*",
    "https://api.aniskip.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.animeon.cc/*",
        "*://*.animeon.co/*",
        "*://*.animeon.su/*",
        "*://*.animeon.org/*",
        "*://*.animeon.to/*",
        "*://*.animeon.tv/*",
        "*://*.animeon.site/*",
        "*://*.kodikplayer.com/*",
        "*://*.kodik.info/*",
        "*://*.kodik.cc/*",
        "*://*.kodik.biz/*"
      ],
      "js": [
        "inject-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.animeon.cc/*",
        "*://*.animeon.co/*",
        "*://*.animeon.su/*",
        "*://*.animeon.org/*",
        "*://*.animeon.to/*",
        "*://*.animeon.tv/*",
        "*://*.animeon.site/*",
        "*://*.kodikplayer.com/*",
        "*://*.kodik.info/*",
        "*://*.kodik.cc/*",
        "*://*.kodik.biz/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject-main.js"
      ],
      "matches": [
        "*://*.animeon.cc/*",
        "*://*.animeon.co/*",
        "*://*.animeon.su/*",
        "*://*.animeon.org/*",
        "*://*.animeon.to/*",
        "*://*.animeon.tv/*",
        "*://*.animeon.site/*",
        "*://*.kodikplayer.com/*",
        "*://*.kodik.info/*",
        "*://*.kodik.cc/*",
        "*://*.kodik.biz/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AnimeOn Skipper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}